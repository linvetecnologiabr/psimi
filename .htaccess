# Rewrite
<IfModule mod_rewrite.c>
RewriteEngine On

# Forçar HTTPS (só em produção, ignora localhost)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Sem WWW
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

# Migracao do WordPress antigo. O Search Console ainda lista 31 URLs de 2024
# respondendo 404, com historico de rastreamento desde 09/04/2024. Cada uma
# volta 301 para a pagina equivalente de hoje. As que nao tem equivalente
# (/pri/, /course.html, /agenda/, feed de busca) continuam 404 de proposito.
RewriteRule ^(ansiedade|depressao|dependencia-emocional|morte-e-luto|violencia-domestica|terapia-de-casal)/?(index\.html)?$ /especialidades/$1 [R=301,L,NE]
RewriteRule ^inseguranca-e-baixa-autoestima/?(index\.html)?$ /especialidades/inseguranca [R=301,L,NE]
RewriteRule ^acompanhamento-psicologico/?(index\.html)?$ /especialidades/ [R=301,L,NE]
RewriteRule ^como-funciona-a-terapia-de-casal/?(index\.html)?$ /blog/terapia-de-casal [R=301,L,NE]
RewriteRule ^(como-voce-tem-lidado-com-seu-tempo|equilibrando-os-pratos-da-vida|estabelecendo-limites|paixao-e-objeto-fantasmatico|para-ser-dois-e-preciso-ser-um|quando-o-sofrimento-parece-nao-ter-fim)/?(index\.html)?$ /blog/$1 [R=301,L,NE]
RewriteRule ^2024/[0-9]{2}(/page/[0-9]+)?/?$ /blog/ [R=301,L,NE]
RewriteRule ^category/blog/?(index\.html)?$ /blog/ [R=301,L,NE]
RewriteRule ^index\.html$ / [R=301,L,NE]

# Sitemap XML dinâmico
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# URL canonica: /pagina.php e /index.php redirecionam 301 para a versao limpa.
# Sem isso cada pagina responde 200 em dois enderecos e o Google ve conteudo duplicado.
# THE_REQUEST e REQUEST_URI carregam o caminho completo, entao a regra vale
# tanto na raiz do dominio quanto em subpasta no ambiente local.
RewriteCond %{THE_REQUEST} \s/+(.*?)index\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Barra final em pagina (nao em diretorio real) devolvia 500 por loop de rewrite.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^ %1 [R=301,L,NE]

# Adicionar .php se o arquivo existir
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

# 404
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule . 404.php [L]
</IfModule>

# Compressão GZIP para melhor performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache do Navegador (Browser Caching)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType application/x-javascript "access plus 1 month"
  ExpiresByType application/x-shockwave-flash "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresDefault "access plus 2 days"
</IfModule>

# Headers de Cache
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "max-age=2592000, public"
  </FilesMatch>
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "max-age=31536000, public"
  </FilesMatch>
</IfModule>

# Segurança
<FilesMatch "\.(env|md|json|lock|log)$">
  Order allow,deny
  Deny from all
</FilesMatch>

# Desabilitar listagem de diretórios
Options -Indexes

# ETags - usar apenas FileETag para consistência
FileETag MTime Size

# Vary header para encoding
<IfModule mod_headers.c>
  Header append Vary Accept-Encoding
</IfModule>

# Proteger contra XSS e Clickjacking
<IfModule mod_headers.c>
  Header set X-XSS-Protection "1; mode=block"
  Header always append X-Frame-Options SAMEORIGIN
  Header set X-Content-Type-Options nosniff
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Limite de upload
# Sob PHP-FPM o Apache nao entende php_value e devolve 500. Ajustar no pool psimi.conf.
# php_value upload_max_filesize 64M
# php_value post_max_size 64M
# php_value max_execution_time 300
# php_value max_input_time 300
